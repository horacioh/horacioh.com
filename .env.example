# Seed site the blog is built from (placeholders until the real site is set).
PUBLIC_SEED_ORIGIN=https://<your-site>.hyper.media
PUBLIC_SEED_ACCOUNT=z6Mk<account-id>
# Seed path prefix of the posts collection (docs at /<prefix>/<slug>).
PUBLIC_SEED_POSTS_PATH=posts
# Optional pages collection: a prefix, or "/" for top-level docs (minus posts). Unset = no pages.
# PUBLIC_SEED_PAGES_PATH=/
# Canonical site URL used for canonical/OG/RSS links.
SITE_URL=https://horacioh.com
