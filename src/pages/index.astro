---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";

const [home] = await getCollection("home");
if (!home) throw new Error("Seed home document is missing");
const { Content } = await render(home);
---
<Base>
  <h1 class="sr-only">{home.data.name}</h1>
  <div class="prose rise" style="--i: 0">
    <Content />
  </div>
</Base>
