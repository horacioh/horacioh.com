---
import Base from "../layouts/Base.astro";
---
<Base title="Not found">
  <section class="rise" style="--i: 0">
    <p class="text-[0.9375rem] tabular-nums text-faint">404</p>
    <h1 class="mt-3 font-display text-[2.125rem] font-semibold leading-tight tracking-[-0.028em]">This page isn’t here.</h1>
    <p class="mt-4 text-[1.1875rem] text-muted">It may have moved when the site switched to Seed.</p>
    <a href="/" class="text-link mt-8 inline-flex min-h-11 items-center">Back to all writing</a>
  </section>
</Base>
