---
import Base from "../layouts/Base.astro";
---
<Base title="Not found">
  <section class="rise" style="--i: 0">
    <p class="font-mono text-sm text-faint">404</p>
    <h1 class="mt-3 text-[1.75rem] font-semibold tracking-[-0.02em]">This page isn't here.</h1>
    <p class="mt-4 text-muted">It may have moved when the site switched to Seed.</p>
    <a href="/" class="group -ml-2 mt-6 inline-flex min-h-11 items-center gap-1.5 rounded-md px-2 text-accent">
      <span aria-hidden="true">←</span><span class="link-draw">Back to all writing</span>
    </a>
  </section>
</Base>
