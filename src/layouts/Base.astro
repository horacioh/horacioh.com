---
import { getCollection } from "astro:content";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { PAGES_PATH, getSiteInfo } from "../lib/seed";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  image?: string;
  published?: Date;
  updated?: Date;
  authors?: string[];
}

const { title, description, type = "website", image, published, updated, authors = [] } = Astro.props;
const site = await getSiteInfo();
const siteName = site.name ?? "Horacio Herrera";
const desc = description ?? site.summary ?? `Writing by ${siteName}`;
const documentTitle = title ? `${title} · ${siteName}` : siteName;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, "") || "/", Astro.site).toString();
const ogImage = new URL(image ?? "/og.jpg", Astro.site).toString();
const pages = (PAGES_PATH === null ? [] : await getCollection("pages"))
  .filter((p) => !p.id.includes("/"))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const current = Astro.url.pathname.replace(/\/$/, "");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#fbfaf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141312" media="(prefers-color-scheme: dark)" />
    <title>{documentTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title ?? siteName} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    {authors.map((a) => <meta property="article:author" content={a} />)}
    <ClientRouter />
  </head>
  <body class="min-h-dvh">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-surface focus:px-3 focus:py-2 focus:ring-1 focus:ring-line"
    >Skip to content</a>
    <div class="mx-auto flex min-h-dvh max-w-[38rem] flex-col px-6">
      <header class="flex items-center justify-between gap-4 pt-6 sm:pt-10" transition:name="site-header">
        <a
          href="/"
          class="-ml-2 inline-flex min-h-11 items-center px-2 font-display text-[1.0625rem] font-semibold tracking-[-0.01em]"
          aria-current={current === "" ? "page" : undefined}
        >{siteName}</a>
        <nav aria-label="Main" class="-mr-2 flex items-center text-[0.9375rem] text-muted">
          {pages.map((p) => (
            <a
              href={`/${p.id}`}
              class:list={["inline-flex min-h-11 items-center px-2.5 transition-colors hover:text-fg", current === `/${p.id}` && "text-fg"]}
              aria-current={current === `/${p.id}` ? "page" : undefined}
            >{p.data.title}</a>
          ))}
          <a href="/rss.xml" class="inline-flex min-h-11 items-center px-2.5 transition-colors hover:text-fg">RSS</a>
        </nav>
      </header>
      <main id="content" class="flex-1 pb-28 pt-16 sm:pt-24" transition:animate="fade">
        <slot />
      </main>
      <footer
        class="flex flex-wrap items-center justify-between gap-x-6 gap-y-1 border-t border-line py-6 text-sm text-faint"
        transition:name="site-footer"
      >
        <span>© {new Date().getFullYear()} {siteName}</span>
        <span>Written in <a href="https://seed.hyper.media" class="text-muted transition-colors hover:text-fg">Seed</a></span>
      </footer>
    </div>
  </body>
</html>
